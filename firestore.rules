rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'qafizz@qafizz.com'
        && request.auth.token.email_verified == true;
    }
    // Anyone can look up certs; only the verified admin can add, change or delete them.
    match /certs/{cert} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /images/{cert} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
